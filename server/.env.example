# ---------- Core ----------
PORT=5000
NODE_ENV=development
# Required. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=3d
# PostgreSQL connection string, e.g. postgresql://user:password@localhost:5432/akazi
DATABASE_URL=
# Set to true for hosted databases that require SSL (Neon, Supabase, Render ...)
DATABASE_SSL=false
# Public address of the website (used in email links and CORS). Production must be https.
CLIENT_URL=http://localhost:5173

# ---------- Email (Resend) ----------
# Leave RESEND_API_KEY empty in development: emails are printed in the server console instead.
RESEND_API_KEY=
# Until you verify your own domain in Resend, only onboarding@resend.dev works (and it can only email your own address).
MAIL_FROM=Akazi <onboarding@resend.dev>
# true = people must confirm their email before applying or posting jobs (needs a verified Resend domain)
REQUIRE_EMAIL_VERIFICATION=false

# ---------- Private file storage (Backblaze B2 or Cloudflare R2) ----------
# Backblaze B2 (S3-compatible):
# 1. Bucket -> create bucket (Private), note the Endpoint (e.g. s3.us-east-005.backblazeb2.com)
# 2. App Keys -> create Application Key with read/write access to that bucket
B2_ENDPOINT=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_REGION=

# Or Cloudflare R2:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---------- PayPack (mobile money) ----------
PAYPACK_CLIENT_ID=
PAYPACK_CLIENT_SECRET=
PAYPACK_EMPLOYER_FEE_RWF=5000
# Mandatory when PayPack is used: payments are ignored without a valid signature
PAYPACK_WEBHOOK_SECRET=
# Optional: in-process reconciliation scheduler interval in minutes (default off)
RECONCILE_PAYMENTS_INTERVAL_MIN=

# ---------- Antivirus Scanner (ClamAV) ----------
# ClamAV daemon host and port (TCP INSTREAM protocol).
# In production, files remain quarantined (error status) if ClamAV is not configured,
# unless ALLOW_UNSCANNED_UPLOADS=true is explicitly set.
# In development, scans default to clean if CLAMAV_HOST is not set.
CLAMAV_HOST=
CLAMAV_PORT=3310
ALLOW_UNSCANNED_UPLOADS=false

# ---------- Behind the Cloudflare Worker ----------
# Same random value as the Worker secret PROXY_SECRET. Lets the API see each visitor's real IP for rate limiting.
PROXY_SECRET=
TRUST_PROXY=1
