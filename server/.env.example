PORT=5000
NODE_ENV=production
# generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/akazi
CLIENT_URL=https://your-domain.rw

# --- PayPack (Rwanda mobile money: MTN MoMo, Airtel Money, Tigo Cash) ---
# Create an application in the PayPack dashboard to obtain these credentials.
# Docs: https://docs.paypack.rw
PAYPACK_BASE_URL=https://payments.paypack.rw/api
PAYPACK_CLIENT_ID=
PAYPACK_CLIENT_SECRET=
# Secret shown on the webhook configuration card (used to verify X-Paypack-Signature)
PAYPACK_WEBHOOK_SECRET=
# "Development" or "Production" - must match your dashboard webhook mode
PAYPACK_MODE=Development
# Employer verification fee in RWF
PAYPACK_EMPLOYER_FEE_RWF=5000
