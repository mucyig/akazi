# Copy to server/.env and fill in. Never commit or share the real .env.
PORT=5000
NODE_ENV=development
JWT_SECRET=            # node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_EXPIRES_IN=3d
DATABASE_URL=postgresql://user:password@localhost:5432/akazi
